  "players": [
    {
      "title": "Competitive Depth & Identity",
      "text": "Players want games that reward individual skill, strategy, and high-stakes plays."
    },
    {
      "title": "Smooth Performance",
      "text": "Players want stable frame rates without laggy servers or visual effects that overwhelm gameplay."
    },
    {
      "title": "Responsive & Fair Combat",
      "text": "Players expect reliable registration and immediate inputs without sluggish trades or delayed responses."
    }
  ],
  "goals": [
    {
      "title": "Engineering Responsive Gameplay",
      "text": "Prioritizing zero-lag regional matchmaking, precise hitboxes, and clean system architecture over performance-heavy visual clutter."
